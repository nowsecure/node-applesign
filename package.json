{
  "type": "module",
  "author": {
    "name": "Sergi Alvarez"
  },
  "bin": {
    "applesign": "dist/bin/applesign.js"
  },
  "engines": {
    "node": ">=22.22",
    "npm": ">=10"
  },
  "scripts": {
    "indent-check": "deno fmt --check",
    "indent": "deno fmt",
    "unzip-lzfse": "git clone https://github.com/sskaje/unzip-lzfse ; cd unzip-lzfse ; chmod +x unix/configure ; LZFSE_PATH=/usr/local make -f unix/Makefile CF='-DUSE_LZFSE=1 -c -O3 -Wall -DBSD -I. -Ibzip2 -DUNIX' LF2=-llzfse all",
    "test": "npm run build && chmod +x dist/bin/applesign.js && node --test test/test.ts",
    "dist": "./scripts/dist.sh",
    "prepack": "npm run build",
    "prebuild": "node scripts/update-version.cjs",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "deno": "^2.9.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@nodelib/fs.walk": "^3.0.1",
    "fatmacho": "0.1.2",
    "macho": "^1.5.0",
    "macho-entitlements": "^0.2.3",
    "macho-is-encrypted": "^0.1.2",
    "plist": "github:trufae/plist.js#a9d3e06148dcee5d89d97e1120b8ea5f35d36666",
    "which": "^7.0.0"
  },
  "description": "API to resign IPA files",
  "homepage": "https://www.nowsecure.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nowsecure/node-applesign.git"
  },
  "keywords": [
    "binary",
    "iphone",
    "codesign",
    "ios",
    "osx"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist/**/*.js",
    "/dist/**/*.d.ts"
  ],
  "maintainers": [
    {
      "name": "Sergi Alvarez",
      "email": "pancake@nowsecure.com"
    }
  ],
  "name": "applesign",
  "version": "7.0.0"
}
